# Dependencies
node_modules/

# Next.js build output
.next/
out/

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Local Google credentials (service-account key, OAuth client secret,
# NEXT_PUBLIC_SITE_URL override) - never commit. Next.js loads .env.local
# automatically in every environment, dev and `next start` alike.
.env.local

# Admin auth secrets and session store - never commit
.env.admin-auth.json
.env.admin-sessions.json

# Runtime content stores - environment-specific, regenerated on first use.
# Keep these out of version control so a deploy never overwrites live site
# content (cards, projects, home text, SMTP creds, visitor count, etc.) with
# whatever happened to be on a developer's machine.
.env.home-text.json
.env.cards.json
.env.projects.json
.env.about-content.json
.env.smtp.json
.env.social-config.json
.env.social-post-log.json
.env.visitor-count.json

# Uploaded media - environment-specific, not source
# Local-backend uploaded media — served dynamically via
# /api/media/local/[...path], deliberately NOT under public/ (see
# src/lib/media.ts for why: Next's production static-file serving snapshots
# public/ once at boot, so files written there while the server is already
# running would never become reachable).
/uploads/

# Editor/tooling
.claude/
.impeccable/

# OS
Thumbs.db
.DS_Store
.env.google-links.json
